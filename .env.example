# CodePati Environment Variables Template
# Duplicate this file to .env and configure real credentials

DATABASE_URL="postgresql://username:password@localhost:5432/codepati?schema=public"

# Auth.js Secret
# Generate using: npx auth secret or openssl rand -hex 32
AUTH_SECRET="your_auth_secret_here"

# Google OAuth Credentials (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_client_id_here"
AUTH_GOOGLE_SECRET="your_google_client_secret_here"
